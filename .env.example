VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the legacy anon JWT (starts with eyJ...) from Project Settings → API Keys.
# sb_publishable_... can cause Invalid JWT with some client/gateway combinations.
VITE_SUPABASE_ANON_KEY=

# Auth: magic-link redirect uses the browser origin (not hardcoded).
# In Supabase → Authentication → URL Configuration, set Site URL to
# http://localhost:5173 and allow Redirect URLs:
#   http://localhost:5173/**
#   http://127.0.0.1:5173/**
#   http://192.168.*.*:5173/**
# Otherwise Supabase falls back to Site URL (often localhost:3000).
